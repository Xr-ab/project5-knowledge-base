# 项目5 环境变量模板 —— 复制成 .env 后填写真实值（.env 已被 gitignore，不会上传）
# 注意：模板里永远只放占位符！真实 key 放 .env

# ===== 必填（没有这两个服务起不来，config.py 早失败设计）=====
# 大模型 API Key（走 OpenAI 兼容协议）。当前默认接智谱 GLM-4-Flash（免费档）：
#   申请地址 https://bigmodel.cn/usercenter/proj-mgmt/apikeys，key 形如 {id}.{secret}
# 换成 DeepSeek / OpenAI 也可以，只改 key + 下面两个可选变量，代码不用动。
LLM_API_KEY=你的key
# 博查搜索 API Key（模块 5 联网搜索用）
BOCHA_API_KEY=你的key

# ===== 可选（有默认值，不填走 config.py 里的默认）=====
# MODEL_NAME=glm-4-flash
# MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDINGS_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 数据库端口：裸机连 docker 里的 postgres 用 5434（5432 被 project6 占用）；容器里由 compose 注入 5432
# DATABASE_PORT=5434
