# 项目5 环境变量模板 —— 复制成 .env 后填写真实值（.env 已被 gitignore，不会上传）
# 注意：模板里永远只放占位符！真实 key 放 .env

# ===== 必填（没有这两个服务起不来，config.py 早失败设计）=====
# DeepSeek 大模型 API Key（OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-你的key
# 博查搜索 API Key（模块 5 联网搜索用）
BOCHA_API_KEY=你的key

# ===== 可选（有默认值，不填走 config.py 里的默认）=====
# MODEL_NAME=deepseek-v4-flash
# MODEL_BASE_URL=https://api.deepseek.com/v1
# EMBEDDINGS_MODEL_NAME=BAAI/bge-small-zh-v1.5
